<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent">

  <com.MeawCreates.VebWiewer.WaterView
    android:layout_width="match_parent" android:layout_height="match_parent"/>

  <LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">

    <ImageView
      android:id="@+id/logo"
      android:layout_width="96dp" android:layout_height="96dp"
      android:layout_marginBottom="12dp"
      android:scaleType="fitCenter" android:visibility="gone"/>

    <TextView
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="Veb Wiewer" android:textSize="34sp"
      android:textColor="#E6FFFFFF" android:layout_marginBottom="28dp"/>

    <LinearLayout
      android:id="@+id/bar"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical"
      android:paddingStart="20dp" android:paddingEnd="6dp">

      <EditText
        android:id="@+id/url"
        android:layout_width="0dp" android:layout_height="52dp"
        android:layout_weight="1" android:background="@null"
        android:hint="Search or type a URL"
        android:textColor="#FFFFFF" android:textColorHint="#88FFFFFF"
        android:textSize="16sp" android:singleLine="true"
        android:inputType="textUri" android:imeOptions="actionGo"/>

      <ImageButton
        android:id="@+id/go"
        android:layout_width="48dp" android:layout_height="48dp"
        android:padding="12dp" android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_go"/>
    </LinearLayout>
  </LinearLayout>

  <ImageButton
    android:id="@+id/settings"
    android:layout_width="52dp" android:layout_height="52dp"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="20dp" android:layout_marginBottom="24dp"
    android:padding="12dp" android:scaleType="fitCenter"
    android:background="@android:color/transparent"
    android:src="@drawable/ic_gear"/>
</FrameLayout>